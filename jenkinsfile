pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_NAME', defaultValue: 'my-spring-app', description: 'Docker image name')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag')
        string(name: 'DOCKERHUB_USER', defaultValue: 'moje-uzivatelske-jmeno', description: 'Docker Hub username')
        password(name: 'DOCKERHUB_PASS', defaultValue: '', description: 'Docker Hub password')
        string(name: 'CONTAINER_PORT', defaultValue: '8080', description: 'Port, na kterém poběží aplikace v kontejneru')
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/moje-org/moje-repo.git'
            }
        }

        stage('Build JAR') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    sh """
                        docker build -t ${params.IMAGE_NAME}:${params.IMAGE_TAG} .
                    """
                }
            }
        }

        stage('Login to Docker Hub') {
            steps {
                script {
                    sh """
                        echo ${params.DOCKERHUB_PASS} | docker login -u ${params.DOCKERHUB_USER} --password-stdin
                    """
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                script {
                    sh """
                        docker tag ${params.IMAGE_NAME}:${params.IMAGE_TAG} ${params.DOCKERHUB_USER}/${params.IMAGE_NAME}:${params.IMAGE_TAG}
                        docker push ${params.DOCKERHUB_USER}/${params.IMAGE_NAME}:${params.IMAGE_TAG}
                    """
                }
            }
        }

        stage('Run Container (Optional)') {
            steps {
                script {
                    sh """
                        docker rm -f ${params.IMAGE_NAME} || true
                        docker run -d --name ${params.IMAGE_NAME} -p ${params.CONTAINER_PORT}:${params.CONTAINER_PORT} ${params.DOCKERHUB_USER}/${params.IMAGE_NAME}:${params.IMAGE_TAG}
                    """
                }
            }
        }
    }
}